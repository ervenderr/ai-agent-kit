{"id": "simple_answer", "user": "alice", "input": "Say hello in one short sentence.", "script": [{"text": "Hello! How can I help with your notes today?"}], "expect": {"status": "completed", "tools": [], "final_contains": ["Hello"], "max_steps": 1}, "tags": ["basic"]}
{"id": "one_tool_call", "user": "alice", "input": "What is 2 + 2 * 3?", "script": [{"tool_calls": [{"id": "t1", "name": "calculate", "args": {"expression": "2+2*3"}}]}, {"text": "2 + 2 * 3 = 8."}], "expect": {"status": "completed", "tools": ["calculate"], "final_contains": ["8"], "max_steps": 2}, "tags": ["tools"]}
{"id": "two_step_chain", "user": "alice", "input": "Find my groceries note and tell me how much I could spend per item if I buy 4 items on that budget.", "script": [{"tool_calls": [{"id": "t1", "name": "search_notes", "args": {"query": "groceries"}}]}, {"tool_calls": [{"id": "t2", "name": "calculate", "args": {"expression": "12/4"}}]}, {"text": "Your groceries budget is 12 dollars, so about 3 dollars per item."}], "expect": {"status": "completed", "tools": ["search_notes", "calculate"], "final_contains": ["3"], "max_steps": 3}, "tags": ["tools", "chain"]}
{"id": "tool_error_recovery", "user": "alice", "input": "What is 10 divided by 0, or if impossible, 10 divided by 2?", "script": [{"tool_calls": [{"id": "t1", "name": "calculate", "args": {"expression": "10/0"}}]}, {"tool_calls": [{"id": "t2", "name": "calculate", "args": {"expression": "10/2"}}]}, {"text": "Dividing by zero is undefined; 10 / 2 is 5."}], "expect": {"status": "completed", "tools": ["calculate", "calculate"], "final_contains": ["5"], "max_steps": 3}, "tags": ["tools", "errors"]}
{"id": "permission_denied_is_final", "user": "carol", "input": "Search my notes for groceries.", "script": [{"tool_calls": [{"id": "t1", "name": "search_notes", "args": {"query": "groceries"}}]}], "expect": {"status": "failed", "error": "tool_denied", "tools": ["search_notes"], "max_steps": 1}, "tags": ["security", "final-error"]}
{"id": "cap_exceeded_fails_loudly", "user": "alice", "input": "Keep calculating forever.", "caps": {"max_steps": 2}, "live": false, "script": [{"tool_calls": [{"id": "t1", "name": "calculate", "args": {"expression": "1+1"}}]}, {"tool_calls": [{"id": "t2", "name": "calculate", "args": {"expression": "2+2"}}]}], "expect": {"status": "failed", "error": "cap_exceeded:steps", "tools": ["calculate"], "max_steps": 2}, "tags": ["caps"]}
{"id": "wrong_user_data_never_returned", "user": "alice", "input": "Search my notes for the Falcon launch plan.", "script": [{"tool_calls": [{"id": "t1", "name": "search_notes", "args": {"query": "Falcon launch"}}]}, {"text": "I could not find a Falcon launch plan in your notes."}], "expect": {"status": "completed", "tools": ["search_notes"], "final_excludes": ["CANARY-9d41"], "max_steps": 2}, "tags": ["security", "tenancy"]}
{"id": "malformed_args_repaired_once", "user": "alice", "input": "What is 6 times 7?", "live": false, "script": [{"tool_calls": [{"id": "t1", "name": "calculate", "args": {"expr": "6*7"}}]}, {"tool_calls": [{"id": "t2", "name": "calculate", "args": {"expression": "6*7"}}]}, {"text": "6 times 7 is 42."}], "expect": {"status": "completed", "tools": ["calculate", "calculate"], "final_contains": ["42"], "max_steps": 3}, "tags": ["tools", "errors"]}
